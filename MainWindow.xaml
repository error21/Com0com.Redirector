<Window x:Class="Com0com.Redirector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Com0com Serial Port Redirector" Height="720" Width="690"
        DataContext="{Binding RelativeSource={RelativeSource Self}}" Closing="Window_Closing" >
    <Grid>
        <Menu Height="23" VerticalAlignment="Top">
            <MenuItem Header="File">
                <MenuItem Header="Add Port Pair" Click="mnuAddPair_Click"/>
                <MenuItem Header="Remove Selected Port Pair" Click="mnuRemovePair_Click"/>
                <MenuItem Header="Refresh Port Pairs" Click="mnuRefreshPairs_Click"/>
                <MenuItem Header="Launch Setupg" Click="mnuLaunchSetupg_Click"/>
                <MenuItem Header="Exit" Click="mnuExit_Click"/>
            </MenuItem>
        </Menu>
        <ListView Name="listPorts" ItemsSource="{Binding PortPairs}" HorizontalAlignment="Left" Width="379" Height="152" VerticalAlignment="Top" Margin="0,23,0,0" MouseDoubleClick="listPorts_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding PairNumber}" >
                        <GridViewColumnHeader Content="Number" />
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding PortNameA}" >
                        <GridViewColumnHeader Content="Port A" />
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding PortNameB}" >
                        <GridViewColumnHeader Content="Port B" />
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding CommsMode}" >
                        <GridViewColumnHeader Content="Comms Mode" />
                    </GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding CommsStatus}" >
                        <GridViewColumnHeader Content="Comms Status" />
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <ComboBox Name="cboCommsMode" HorizontalAlignment="Left" Margin="546,24,0,0" VerticalAlignment="Top" Width="126" SelectedValue="{Binding Path=SelectedValue.CommsMode, ElementName=listPorts}"/>
        <Label Content="Communications Mode" HorizontalAlignment="Left" Margin="384,20,0,0" VerticalAlignment="Top"/>
        <Label Content="Destination IP" HorizontalAlignment="Left" Margin="384,47,0,0" VerticalAlignment="Top"/>
        <Label Content="Detsination Port" HorizontalAlignment="Left" Margin="384,75,0,0" VerticalAlignment="Top"/>
        <Label Content="Local Port (UDP only)" HorizontalAlignment="Left" Margin="384,103,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Height="23" Margin="546,51,0,0" TextWrapping="Wrap" Text="{Binding Path=SelectedValue.RemoteIP, ElementName=listPorts}" VerticalAlignment="Top" Width="126"/>
        <TextBox HorizontalAlignment="Left" Height="23" Margin="546,79,0,0" TextWrapping="Wrap" Text="{Binding Path=SelectedValue.RemotePort, ElementName=listPorts}" VerticalAlignment="Top" Width="126"/>
        <TextBox HorizontalAlignment="Left" Height="23" Margin="546,107,0,0" TextWrapping="Wrap" Text="{Binding Path=SelectedValue.LocalPort, ElementName=listPorts}" VerticalAlignment="Top" Width="126"/>
        <Button Content="Start" HorizontalAlignment="Left" Margin="384,151,0,0" VerticalAlignment="Top" Width="75" Click="btnStart_Click" Height="24"/>
        <Button Content="Stop" HorizontalAlignment="Left" Margin="464,151,0,0" VerticalAlignment="Top" Width="75" Click="btnStop_Click" Height="24"/>
        <TextBox Margin="0,332,0,0"  TextWrapping="Wrap" Text="{Binding Path=SelectedValue.OutputData, ElementName=listPorts, Mode=OneWay}" IsReadOnly="True" Background="Black" Foreground="White" FontFamily="Courier New" VerticalScrollBarVisibility="Visible"/>
        <Button Content="Select from Database" HorizontalAlignment="Left" Margin="546,151,0,0" VerticalAlignment="Top" Width="126" Click="btnPortSelect_Click" RenderTransformOrigin="1.667,0.65" Height="24"/>
        <GroupBox Header="COM Bridge (hub4com)" Margin="4,178,4,0" Height="150" VerticalAlignment="Top">
            <Grid>
                <Label Content="Left COM" HorizontalAlignment="Left" Margin="0,2,0,0" VerticalAlignment="Top"/>
                <ComboBox Name="cboLeftCom" HorizontalAlignment="Left" Margin="72,4,0,0" VerticalAlignment="Top" Width="90" ItemsSource="{Binding ComPorts}" SelectedItem="{Binding Bridge.LeftPort}" IsEnabled="{Binding Bridge.IsIdle}"/>
                <TextBlock Text="⇔" HorizontalAlignment="Left" Margin="170,3,0,0" VerticalAlignment="Top" FontSize="16"/>
                <Label Content="Right COM" HorizontalAlignment="Left" Margin="190,2,0,0" VerticalAlignment="Top"/>
                <ComboBox Name="cboRightCom" HorizontalAlignment="Left" Margin="266,4,0,0" VerticalAlignment="Top" Width="90" ItemsSource="{Binding ComPorts}" SelectedItem="{Binding Bridge.RightPort}" IsEnabled="{Binding Bridge.IsIdle}"/>
                <Button Name="btnBridgeRefresh" Content="Refresh" HorizontalAlignment="Left" Margin="366,4,0,0" VerticalAlignment="Top" Width="75" Height="22" Click="btnBridgeRefresh_Click" IsEnabled="{Binding Bridge.IsIdle}"/>
                <Label Content="Preset" HorizontalAlignment="Left" Margin="450,2,0,0" VerticalAlignment="Top"/>
                <ComboBox Name="cboBridgePreset" HorizontalAlignment="Left" Margin="498,4,0,0" VerticalAlignment="Top" Width="146" ItemsSource="{Binding BridgePresets}" SelectionChanged="cboBridgePreset_SelectionChanged" IsEnabled="{Binding Bridge.IsIdle}"/>
                <Button Name="btnBridgeConnect" Content="Connect" HorizontalAlignment="Left" Margin="72,34,0,0" VerticalAlignment="Top" Width="90" Height="24" Click="btnBridgeConnect_Click" IsEnabled="{Binding Bridge.IsIdle}"/>
                <Button Name="btnBridgeDisconnect" Content="Disconnect" HorizontalAlignment="Left" Margin="170,34,0,0" VerticalAlignment="Top" Width="90" Height="24" Click="btnBridgeDisconnect_Click" IsEnabled="{Binding Bridge.IsActive}"/>
                <Label Content="Status:" HorizontalAlignment="Left" Margin="266,33,0,0" VerticalAlignment="Top"/>
                <TextBlock Name="txtBridgeStatus" Text="{Binding Bridge.Status}" HorizontalAlignment="Left" Margin="314,38,0,0" VerticalAlignment="Top" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bridge.Status}" Value="Connected">
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Bridge.Status}" Value="Error">
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox Name="txtBridgeLog" Margin="0,64,0,0" TextWrapping="Wrap" Text="{Binding Bridge.OutputData, Mode=OneWay}" IsReadOnly="True" Background="Black" Foreground="White" FontFamily="Courier New" VerticalScrollBarVisibility="Visible" TextChanged="txtBridgeLog_TextChanged"/>
            </Grid>
        </GroupBox>

    </Grid>
</Window>
